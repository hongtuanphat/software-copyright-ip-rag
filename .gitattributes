# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code and text files explicitly forced to LF line endings
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.index binary
